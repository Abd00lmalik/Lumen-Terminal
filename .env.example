[TEMPLATE]
# Copy to `.env` and fill in. Never commit `.env`.

# Gemini model provider (M3) — credentials from environment only.
GEMINI_API_KEY=
# Model ID resolved by the config layer; gemini-3.5-flash-lite is the safe default when unset.
# Default chosen by the 2026-09-14 free-tier audit: verified live on the API key (200 + valid
# structured JSON) as the smallest model that reliably performs the LUI's structured tasks.
# Free-tier quotas are PER MODEL per day — gemini-3.6-flash only allows ~20 requests/day,
# while lighter Flash-Lite models carry larger buckets and ample capability for classification,
# clarification, and research planning. Override with any model your key can access
# (e.g. GEMINI_MODEL=gemini-3.5-flash for heavier synthesis).
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq model provider (second LLM, model fallback) — optional. When set, Groq serves as the
# typed fallback if Gemini fails technically (quota/outage/timeout). OpenAI-compatible;
# free tier; llama-3.3-70b-versatile is the safe default when unset.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Heurist Mesh (specialized data-provider fallbacks: options chains, funding/OI, SEC filings,
# FRED macro) — optional. When set, Heurist agents register as low-priority capability
# providers behind the direct keyless providers. See docs/integrations/heurist.md.
HEURIST_API_KEY=
